## Phase 2: Define the Profile Registry

### Step 2.1: Define `SidebarProfileConfig` type and `PROFILE_REGISTRY` constant

**File**: [folderSidebarView.svelte.ts](file:///Users/dduraipandian/apps/mdnotes/frontend/src/lib/views/folderSidebarView.svelte.ts)
**Location**: After `FOLDER_COLOR` constant (line 15), before the class.

```typescript
type SidebarProfileConfig = {
	iconName: FolderIcon;
	capabilities: SidebarCapabilities;
	childrenExpandable: boolean; // When true, children of this kind can show THEIR sub-children
	showDeletedChildren: boolean; // When true, children with deletedAt != null are visible (for trash)
};

const ICON_REGISTRY: Record<FolderIcon, { component: Component<any>; props: Record<string, any> }> = {
	folder: { component: Folder, props: { style: `color: ${FOLDER_COLOR}`, class: 'opacity-80' } },
	star: { component: Star, props: { class: 'fill-[#e0b64b] text-[#e0b64b]' } },
	trash: { component: Trash2, props: { class: 'text-destructive/70' } }
};

const PROFILE_REGISTRY: Record<SidebarKind, SidebarProfileConfig> = {
	trash: {
		iconName: 'trash',
		capabilities: {
			create: false, rename: false, delete: false,
			recover: false, permanentDelete: false,
			emptyTrash: true, favorite: false
		},
		childrenExpandable: false,
		showDeletedChildren: true
	},
	favorites: {
		iconName: 'star',
		capabilities: {
			create: false, rename: false, delete: false,
			recover: false, permanentDelete: false,
			emptyTrash: false, favorite: false
		},
		childrenExpandable: false,
		showDeletedChildren: false
	},
	home: {
		iconName: 'folder',
		capabilities: {
			create: true, rename: false, delete: false,
			recover: false, permanentDelete: false,
			emptyTrash: false, favorite: false
		},
		childrenExpandable: true,
		showDeletedChildren: false
	},
	regular: {
		iconName: 'folder',
		capabilities: {
			create: true, rename: true, delete: true,
			recover: false, permanentDelete: false,
			emptyTrash: false, favorite: true
		},
		childrenExpandable: true,
		showDeletedChildren: false
	},
	deleted: {
		iconName: 'folder',
		capabilities: {
			create: false, rename: false, delete: false,
			recover: true, permanentDelete: true,
			emptyTrash: false, favorite: false
		},
		childrenExpandable: false,
		showDeletedChildren: false
	}
};
```

> [!TIP]
> **To add a new system folder in the future**, you only need to:
> 1. Add a new `SidebarKind` value (e.g. `'archive'`)
> 2. Add its entry in `PROFILE_REGISTRY`
> 3. Add a case in `resolveKind()`
> 4. (Optional) Add a case in `resolveChildIds()` if it has a custom child source

